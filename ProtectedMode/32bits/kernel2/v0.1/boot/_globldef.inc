DISK_SECTOR_SIZE_BYTES equ 512

BOOTLOADER_DISKBLOCK_SIZE_SECTORS equ 1
BOOTLOADER_DISKBLOCK_SIZE_BYTES equ (BOOTLOADER_DISKBLOCK_SIZE_SECTORS*DISK_SECTOR_SIZE_BYTES)
BOOTLOADER_DISKBLOCK_SECTOR_INDEX equ 1
BOOTLOADER_MEMBLOCK_SIZE_BYTES equ BOOTLOADER_DISKBLOCK_SIZE_BYTES
BOOTLOADER_MEMBLOCK_SEG16 equ 0x0
BOOTLOADER_MEMBLOCK_INDEX16 equ 0x7c00
BOOTLOADER_MEMBLOCK_ADDR32 equ ((BOOTLOADER_MEMBLOCK_SEG16 << 4) | BOOTLOADER_MEMBLOCK_INDEX16)

GDT_DISKBLOCK_SIZE_SECTORS equ 1
GDT_DISKBLOCK_SIZE_BYTES equ (GDT_DISKBLOCK_SIZE_SECTORS*DISK_SECTOR_SIZE_BYTES)
GDT_DISKBLOCK_SECTOR_INDEX equ (BOOTLOADER_DISKBLOCK_SECTOR_INDEX + BOOTLOADER_DISKBLOCK_SIZE_SECTORS)
GDT_MEMBLOCK_SIZE_BYTES equ GDT_DISKBLOCK_SIZE_BYTES
GDT_MEMBLOCK_SEG16 equ 0x0
GDT_MEMBLOCK_INDEX16 equ 0x7e00
GDT_MEMBLOCK_ADDR32 equ ((GDT_MEMBLOCK_SEG16 << 4) | GDT_MEMBLOCK_INDEX16)

KERNEL_DISKBLOCK_SIZE_SECTORS equ 16
KERNEL_DISKBLOCK_SIZE_BYTES equ (KERNEL_DISKBLOCK_SIZE_SECTORS*DISK_SECTOR_SIZE_BYTES)
KERNEL_DISKBLOCK_SECTOR_INDEX equ (GDT_DISKBLOCK_SECTOR_INDEX + GDT_DISKBLOCK_SIZE_SECTORS)
KERNEL_MEMBLOCK_SIZE_BYTES equ 0x1ffff
KERNEL_MEMBLOCK_SEG16 equ 0x1000
KERNEL_MEMBLOCK_INDEX16 equ 0x0
KERNEL_MEMBLOCK_ADDR32 equ ((KERNEL_MEMBLOCK_SEG16 << 4) | KERNEL_MEMBLOCK_INDEX16)

DATA_MEMBLOCK_SIZE_BYTES equ 0xfffff
DATA_MEMBLOCK_SEG16 equ 0x0
DATA_MEMBLOCK_INDEX16 equ 0x0
DATA_MEMBLOCK_ADDR32 equ ((DATA_MEMBLOCK_SEG16 << 4) | DATA_MEMBLOCK_INDEX16)

; GENERAL PARAMS

BOOTDEVID_SEG16 equ 0x0
BOOTDEVID_INDEX16 equ 0x7bfe
BOOTDEVID_ADDR32 equ ((BOOTDEVID_SEG16 << 4) | BOOTDEVID_INDEX16)

STACK_INIT_BP32 equ 0xa0000

; GDT BLOCK PARAMS

GDTSEG_SIZE_BYTES equ 8

GDT_DESC_ADDR32 equ GDT_MEMBLOCK_ADDR32
GDT_DESC_SIZE_BYTES equ 8

GDT_ADDR32 equ (GDT_DESC_ADDR32 + GDT_DESC_SIZE_BYTES)

GDTSEG_COUNT equ 3
GDT_SIZE_BYTES equ (GDTSEG_COUNT*GDTSEG_SIZE_BYTES)

GDTSEG_KERNEL_INDEX equ 1
GDTSEG_KERNEL_OFFSET equ (GDTSEG_KERNEL_INDEX*GDTSEG_SIZE_BYTES)

GDTSEG_DATA_INDEX equ 2
GDTSEG_DATA_OFFSET equ (GDTSEG_DATA_INDEX*GDTSEG_SIZE_BYTES)

